{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sqlobserver-web-asset-manifest-v1",
  "title": "SqlObserver web asset identity manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "sha256", "entrypoint", "files"],
  "properties": {
    "$schema": { "const": "web-asset-manifest.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "entrypoint": { "$ref": "#/$defs/entrypoint" },
    "files": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/file" }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!~)(?!.*[:\\\\?#\\u0000-\\u001f\\u007f])(?!.*(?:^|/)\\.(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "bytes", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "role": { "type": "string", "enum": ["entry-document", "entry-script", "chunk", "stylesheet", "font", "media", "build-metadata"] },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 4294967296 },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "file", "isEntry", "isDynamicEntry", "imports", "dynamicImports", "css", "assets"],
      "properties": {
        "key": { "$ref": "#/$defs/path" },
        "file": { "$ref": "#/$defs/path" },
        "isEntry": { "type": "boolean" },
        "isDynamicEntry": { "type": "boolean" },
        "imports": { "type": "array", "items": { "$ref": "#/$defs/path" }, "uniqueItems": true },
        "dynamicImports": { "type": "array", "items": { "$ref": "#/$defs/path" }, "uniqueItems": true },
        "css": { "type": "array", "items": { "$ref": "#/$defs/path" }, "uniqueItems": true },
        "assets": { "type": "array", "items": { "$ref": "#/$defs/path" }, "uniqueItems": true }
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "graph"],
      "properties": {
        "document": { "const": "index.html" },
        "graph": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/graph" } }
      }
    }
  }
}
