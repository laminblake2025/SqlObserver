{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sqlobserver.invalid/schemas/m12-certification-manifest.v1.schema.json",
  "title": "SqlObserver M12 certification evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [ "$schema", "schemaVersion", "matrixId", "profile", "commitSha", "generatedAtUtc", "runId", "environments", "artifacts", "lanes", "result" ],
  "properties": {
    "$schema": { "const": "m12-certification-manifest.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "matrixId": { "const": "sqlobserver-m12" },
    "profile": { "enum": [ "Local", "Release" ] },
    "commitSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "runId": { "type": "string", "format": "uuid" },
    "environments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/environment" } },
    "products": { "type": "array", "items": { "$ref": "#/$defs/product" } },
    "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
    "lanes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/lane" } },
    "result": {
      "type": "object", "additionalProperties": false, "required": [ "releaseEvidence", "missing", "unavailable", "skipped", "notRun", "failed" ],
      "properties": {
        "releaseEvidence": { "type": "boolean" },
        "missing": { "type": "integer", "minimum": 0 },
        "unavailable": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "notRun": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "environment": {
      "type": "object", "additionalProperties": false, "required": [ "environmentId", "identity", "os", "architecture", "facts" ],
      "properties": {
        "environmentId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "identity": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "os": { "type": "string", "minLength": 1, "maxLength": 128 },
        "architecture": { "const": "x64" },
        "facts": { "type": "object", "additionalProperties": { "type": [ "string", "number", "boolean", "null" ] } }
      }
    },
    "hashEntry": {
      "type": "object", "additionalProperties": false, "required": [ "path", "sha256" ],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)[^\\\\].*$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false, "required": [ "artifactId", "kind", "producerId", "path", "sha256", "size", "runId", "commitSha", "environmentId", "provenance" ],
      "properties": {
        "artifactId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "producerId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "path": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)[^\\\\].*$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "runId": { "type": "string", "format": "uuid" },
        "commitSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "environmentId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "size": { "type": "integer", "minimum": 1 },
        "productId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "product": {
      "type": "object", "additionalProperties": false,
      "required": [ "productId", "path", "sha256", "size", "runId", "commitSha", "environmentId" ],
      "properties": {
        "productId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "path": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)[^\\\\].*$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "size": { "type": "integer", "minimum": 1 },
        "runId": { "type": "string", "format": "uuid" },
        "commitSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "environmentId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }
      }
    },
    "lane": {
      "type": "object", "additionalProperties": false, "required": [ "laneId", "cases" ],
      "properties": {
        "laneId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
      }
    },
    "case": {
      "type": "object", "additionalProperties": false, "required": [ "caseId", "environmentId", "status", "executions", "skipped", "notRun", "failed", "artifactIds", "evidence" ],
      "properties": {
        "caseId": { "type": "string", "pattern": "^m12-[a-z0-9-]+$" },
        "environmentId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "artifactIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" } },
        "status": { "const": "passed" },
        "executions": { "type": "integer", "minimum": 1 },
        "skipped": { "type": "integer", "minimum": 0 },
        "notRun": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": [ "path", "sha256", "format", "runId", "commitSha", "environmentId" ],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)[^\\\\].*$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "format": { "enum": [ "json", "trx", "junit" ] },
        "runId": { "type": "string", "format": "uuid" },
        "commitSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "environmentId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": [ "path", "sha256" ],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)[^\\\\].*$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      }
    }
  }
}
