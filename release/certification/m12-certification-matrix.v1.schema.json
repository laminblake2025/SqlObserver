{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sqlobserver.invalid/schemas/m12-certification-matrix.v1.schema.json",
  "title": "SqlObserver M12 certification matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [ "$schema", "schemaVersion", "matrixId", "version", "environmentIdentities", "profiles", "lanes" ],
  "properties": {
    "$schema": { "const": "m12-certification-matrix.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "matrixId": { "const": "sqlobserver-m12" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "environmentIdentities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" } },
    "profiles": {
      "type": "object", "additionalProperties": false, "required": [ "Local", "Release" ],
      "properties": {
        "Local": { "$ref": "#/$defs/profile" },
        "Release": { "$ref": "#/$defs/profile" }
      }
    },
    "lanes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": [ "laneId", "producerId", "implementationStatus", "cases" ],
        "properties": {
          "laneId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "producerId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "implementationStatus": { "enum": [ "implemented", "pending" ] },
          "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/matrixCase" } }
        }
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object", "additionalProperties": false, "required": [ "releaseEvidence", "requiredLanes", "omittedExternalLanes" ],
      "properties": {
        "releaseEvidence": { "type": "boolean" },
        "requiredLanes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" } },
        "omittedExternalLanes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" } }
      }
    },
    "matrixCase": {
      "type": "object", "additionalProperties": false, "required": [ "caseId", "producerId", "implementationStatus", "artifactKinds", "environment" ],
      "properties": {
        "caseId": { "type": "string", "pattern": "^m12-[a-z0-9-]+$" },
        "producerId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "implementationStatus": { "enum": [ "implemented", "pending" ] },
        "artifactKinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" } },
        "environment": {
          "type": "object", "additionalProperties": false, "required": [ "identities", "requiredFacts", "factPredicates" ],
          "properties": {
            "identities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" } },
            "requiredFacts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]+$" } },
            "factPredicates": { "type": "object", "minProperties": 1, "additionalProperties": { "type": [ "string", "number", "boolean" ] } }
          }
        }
      }
    }
  }
}
