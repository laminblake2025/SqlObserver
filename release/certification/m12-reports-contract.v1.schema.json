        "src/SqlObserver.Infrastructure.PostgreSql/PostgreSqlReportRepository.cs",
        "src/SqlObserver.Infrastructure.PostgreSql/PostgreSqlReportAuditPort.cs",
        "tests/SqlObserver.IntegrationTests.PostgreSql/M12ReportsCertificationTests.cs",
        "tests/SqlObserver.IntegrationTests.PostgreSql/SqlObserver.IntegrationTests.PostgreSql.csproj",
        "database/migrations/0288_saved_incident_workspace.sql",
