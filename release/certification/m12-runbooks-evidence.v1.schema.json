{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sqlobserver.invalid/schemas/m12-runbooks-evidence.v1.schema.json",
  "title": "SqlObserver M12 runbooks evidence",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "caseId", "producerId", "kind", "result", "commitSha", "environmentId", "runId", "catalogSha256", "matrixSha256", "documents", "prerequisites"],
  "properties": {
    "$schema": { "const": "m12-runbooks-evidence.v1.schema.json" }, "schemaVersion": { "const": 1 }, "caseId": { "const": "m12-runbooks" }, "producerId": { "const": "m12-supply-chain-harness" }, "kind": { "const": "supply-chain-evidence" }, "result": { "const": "passed" }, "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "environmentId": { "enum": ["release-windows-server-2022", "release-windows-server-2025"] }, "runId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" }, "catalogSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "matrixSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "documents": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/document" } }, "prerequisites": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/prerequisite" } }
  },
  "$defs": { "document": { "type": "object", "additionalProperties": false, "required": ["documentId", "path", "sha256", "size", "sectionIds", "procedureIds"], "properties": { "documentId": { "type": "string", "maxLength": 512 }, "path": { "type": "string", "pattern": "^docs/runbooks/[a-z0-9-]+\\.md$", "maxLength": 512 }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "size": { "type": "integer", "minimum": 1, "maximum": 131072 }, "sectionIds": { "type": "array", "minItems": 12, "maxItems": 12, "items": { "type": "string", "maxLength": 512 } }, "procedureIds": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "maxLength": 512 } } } }, "prerequisite": { "type": "object", "additionalProperties": false, "required": ["caseId", "runId"], "properties": { "caseId": { "enum": ["m12-sbom", "m12-licenses", "m12-vulnerability-scan", "m12-provenance"] }, "runId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" } } } }
}
