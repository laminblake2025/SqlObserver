{
  "$schema": "m12-reports-contract.v1.schema.json",
  "schemaVersion": 1,
  "contractId": "m12-reports-exports",
  "producerId": "m12-reports-harness",
  "definitionVersion": 1,
  "reportKinds": [
    "instance-health",
    "performance-window",
    "incident-evidence",
    "capacity-readiness",
    "saved-investigation"
  ],
  "sections": [
    "health",
    "performance",
    "incidents",
    "capacity",
    "investigation",
    "saved-evidence"
  ],
  "formats": {
    "html": "inert-printable",
    "csv": "utf-8-per-section"
  },
  "bounds": {
    "requestBytes": 65536,
    "pageRows": 200,
    "htmlRows": 2000,
    "materializationRows": 10000,
    "responseBytes": 1048576,
    "materializationBytes": 8388608,
    "detailedWindowDays": 7,
    "trendWindowDays": 31,
    "repositoryTimeoutSeconds": 5,
    "totalTimeoutSeconds": 15,
    "actorConcurrency": 2,
    "globalConcurrency": 16,
    "retentionHours": 24
  },
  "encoding": {
    "html": "html-encode-text-and-attributes",
    "csv": "rfc4180",
    "formulaNeutralization": true,
    "formulaSentinels": [
      "=",
      "+",
      "-",
      "@"
    ],
    "controlCharacterNormalization": true,
    "utf8Bom": false,
    "savedNotes": "preserve-unicode-and-crlf-tab",
    "savedEvidence": "json-string-parts-ordered-by-packet-and-part"
  },
  "caseMappings": [
    {
      "caseId": "m12-reports-exports",
      "testName": "LiveReleaseReportsExportsRepresentativeVolumeIsBounded",
      "facts": {
        "reports": true,
        "exports": true,
        "reportKind": null
      }
    },
    {
      "caseId": "m12-report-contract",
      "testName": "LiveReleaseReportContractIsSnapshotScopedAndAudited",
      "facts": {
        "reports": true,
        "exports": false,
        "reportKind": "report"
      }
    },
    {
      "caseId": "m12-export-contract",
      "testName": "LiveReleaseExportContractIsInertAndFormulaSafe",
      "facts": {
        "reports": false,
        "exports": true,
        "reportKind": "export"
      }
    }
  ],
