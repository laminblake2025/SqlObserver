{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sqlobserver.invalid/schemas/m12-license-contract.v1.schema.json",
  "title": "SqlObserver M12 license evidence contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "contractId", "producerId", "artifactKind", "caseId", "environments", "requiredFacts", "factPredicates", "sbomSchema", "outputFiles", "generation", "licensePolicy", "bounds"],
  "properties": {
    "$schema": { "const": "m12-license-contract.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "sqlobserver-m12-licenses" },
    "producerId": { "const": "m12-supply-chain-harness" },
    "artifactKind": { "const": "supply-chain-evidence" },
    "caseId": { "const": "m12-licenses" },
    "environments": { "const": ["release-windows-server-2022", "release-windows-server-2025"] },
    "requiredFacts": { "const": ["os", "architecture", "licenses"] },
    "factPredicates": { "const": { "os": "windows", "architecture": "x64", "licenses": true } },
    "sbomSchema": { "const": "m12-sbom.v1.schema.json" },
    "outputFiles": { "const": ["m12-licenses.json", "m12-licenses-test-evidence.json", "m12-licenses-provenance.json"] },
    "generation": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "deterministic", "timestampSource", "commitSource", "runSource"],
      "properties": {
        "format": { "const": "SPDX-license-evidence" }, "deterministic": { "const": true },
        "timestampSource": { "const": "supplied" }, "commitSource": { "const": "supplied" }, "runSource": { "const": "supplied" }
      }
    },
    "licensePolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["allowedSpdx", "thirdPartyEcosystems", "firstPartyCatalog", "ambiguousExpressionsRejected", "urlOnlyLicensesRejected", "sniRuntimeOverride"],
      "properties": {
        "allowedSpdx": { "const": ["Apache-2.0", "MIT", "PostgreSQL"] },
        "thirdPartyEcosystems": { "const": ["nuget", "npm"] },
        "firstPartyCatalog": { "const": ["pkg:generic/sqlobserver.web@"] },
        "ambiguousExpressionsRejected": { "const": true }, "urlOnlyLicensesRejected": { "const": true },
        "sniRuntimeOverride": {
          "type": "object", "additionalProperties": false, "required": ["purl", "path", "sha256", "spdxId"],
          "properties": { "purl": { "const": "pkg:nuget/microsoft.data.sqlclient.sni.runtime@6.0.2" }, "path": { "const": "LICENSE.txt" }, "sha256": { "const": "9335e8bad875dd7be4eebd55d2335eb6433d1cea61aadb3817af7807bef8932a" }, "spdxId": { "const": "MIT" } }
        }
      }
    },
    "bounds": {
      "type": "object", "additionalProperties": false, "required": ["components", "jsonBytes", "stringLength", "depth"],
      "properties": { "components": { "const": 4096 }, "jsonBytes": { "const": 4194304 }, "stringLength": { "const": 512 }, "depth": { "const": 32 } }
    }
  }
}
