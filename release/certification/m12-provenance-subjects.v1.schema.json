{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sqlobserver.invalid/schemas/m12-provenance-subjects.v1.schema.json",
  "title": "SqlObserver M12 provenance subject set",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "products"],
  "properties": {
    "$schema": { "const": "m12-provenance-subjects.v1.schema.json" }, "schemaVersion": { "const": 1 },
    "products": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/product" } }
  },
  "$defs": {
    "product": { "type": "object", "additionalProperties": false, "required": ["productId", "name", "path", "entryPoint", "sha256", "size"], "properties": {
      "productId": { "type": "string", "enum": ["sqlobserver-collector", "sqlobserver-mcp-stdio", "sqlobserver-server", "sqlobserver-web"] }, "name": { "type": "string", "minLength": 1, "maxLength": 512 }, "path": { "type": "string", "enum": ["publish-0/SqlObserver.Server.exe", "publish-1/SqlObserver.Collector.exe", "publish-2/SqlObserver.McpStdio.exe", "web/dist/index.html"] }, "entryPoint": { "type": "string", "enum": ["SqlObserver.Collector", "SqlObserver.McpStdio", "SqlObserver.Server", "index.html"] }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "size": { "type": "integer", "minimum": 1, "maximum": 4194304 }
    } }
  }
}
