{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sqlobserver-migration-assessment-v1",
  "title": "SqlObserver read-only migration assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "code", "evaluatedAtUtc", "history"],
  "properties": {
    "status": { "type": "string", "enum": ["not_evaluated", "current", "pending", "drift", "gap", "unknown", "unsupported_major", "lock_unavailable", "timed_out", "access_denied", "invalid_history"] },
    "code": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "evaluatedAtUtc": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "serverVersion": { "$ref": "#/$defs/serverVersion" },
    "nextMigrationNumber": { "type": "integer", "minimum": 1, "maximum": 9999 },
    "observedHistoryCount": { "type": "integer", "minimum": 0, "maximum": 256 },
    "history": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/historyEntry" } }
  },
  "$defs": {
    "serverVersion": {
      "type": "object", "additionalProperties": false,
      "required": ["major", "update"],
      "properties": { "major": { "type": "integer", "minimum": 1, "maximum": 99 }, "update": { "type": "integer", "minimum": 0, "maximum": 999 } }
    },
    "historyEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["number", "name", "checksum"],
      "properties": {
        "number": { "type": "integer", "minimum": 1, "maximum": 9999 },
        "name": { "type": "string", "enum": ["0001_repository_bootstrap.sql", "0002_repository_tables.sql", "0003_partition_and_retention_foundations.sql", "0004_repository_functions.sql", "0005_views_and_least_privilege_grants.sql", "0006_replay_validation_functions.sql", "0007_observation_target_capabilities.sql", "0008_collector_scheduling_and_core_health.sql", "0009_activity_sessions_requests_waits_blocking.sql", "0010_deadlocks_extended_events.sql", "0011_query_performance.sql", "0012_alerts_maintenance_notifications.sql", "0013_backups_jobs_tempdb_availability_groups.sql", "0014_analytics_host_replication_retention.sql", "0015_mcp_invocation_audit.sql", "0016_mcp_metric_series_cursor.sql", "0017_mcp_forecast_limit.sql", "0018_mcp_diagnostics_lookahead.sql", "0019_mcp_forecast_cursor.sql", "0020_mcp_snapshot_and_incident_cursor.sql", "0021_reports_exports.sql", "0022_runtime_startup_repairs.sql", "0023_report_expiry_lock_privilege.sql", "0024_report_materialization_column_binding.sql", "0025_report_run_scoped_read.sql", "0026_passive_collector_source_repairs.sql", "0027_populated_evidence_persistence.sql", "0028_restore_partial_collection_outcomes.sql", "0029_operational_payload_kind_binding.sql", "0030_m10_collection_lifecycle.sql", "0031_explicit_host_metric_capabilities.sql", "0032_host_binding_column_resolution.sql", "0033_host_profile_identity_conflict.sql", "0034_replication_visibility_gap_reason.sql", "0035_overview_workload_history.sql", "0036_m10_historical_target_revisions.sql", "0037_replication_agent_activity.sql", "0038_replication_metric_series.sql", "0039_metric_series_collection_fence.sql", "0040_analytics_schema_access.sql", "0041_live_activity.sql", "0042_live_activity_cleanup_capacity.sql", "0043_query_performance_window_index.sql", "0044_query_performance_scope_initplans.sql", "0045_capability_refresh_lead_time.sql", "0046_alert_delivery_snapshot_read.sql", "0047_alert_admin_first_operation.sql", "0048_alert_dispatch_shared_permit.sql", "0049_alert_claim_candidate_bounds.sql", "0050_alert_sample_identity_type.sql", "0051_configured_connection_alert_rules.sql", "0052_alert_sustained_confirmation.sql", "0053_alert_discovery_reset_scope.sql", "0054_deadlock_file_read_deadline.sql", "0055_query_ranking_window_plan.sql", "0056_query_claim_invoker_execution.sql", "0057_query_ranking_window_first.sql", "0058_operational_header_custom_plan.sql", "0059_wait_summary_bounded_plan.sql", "0060_query_ownership_covering_index.sql", "0061_instance_health_custom_plan.sql", "0062_deadlock_collection_headroom.sql", "0063_operational_header_completion_frontier.sql", "0064_activity_snapshot_bounded_plans.sql", "0065_overview_workload_custom_plan.sql", "0066_query_ranking_streamed_window.sql", "0067_alert_evidence_activation_window.sql", "0068_query_ranking_latest_observation.sql", "0069_query_performance_database_catalog.sql", "0070_query_ranking_scoped_runs.sql", "0071_overview_database_activity_history.sql", "0072_deadlock_activity_snapshots.sql", "0073_overview_activity_scoped_reads.sql", "0074_backfill_job_identity.sql", "0075_retention_server_schema_usage.sql", "0076_backfill_cursor_column_binding.sql", "0077_backfill_job_inventory.sql", "0078_mcp_audit_append_bounds.sql"] },
        "checksum": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
