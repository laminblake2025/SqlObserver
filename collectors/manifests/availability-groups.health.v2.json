{
  "$schema": "collector-manifest.v6.schema.json",
  "schemaVersion": 6,
  "collectorId": "availability-groups.health",
  "collectorVersion": 2,
  "displayName": "SQL Server availability groups health",
  "operationalMode": "passive",
  "dependsOn": [
    "capability.connection",
    "engine.core"
  ],
  "supportedTargets": {
    "product": "Microsoft SQL Server",
    "minimumMajorVersion": 15,
    "maximumMajorVersion": 17,
    "platforms": [
      "Windows"
    ],
    "engineEditions": [
      2,
      3
    ]
  },
  "requiredCapabilities": [
    "connection.tds",
    "authentication.windows-integrated",
    "transport.tls-validated",
    "privilege.non-sysadmin",
    "platform.windows",
    "feature.availability-groups"
  ],
  "requiredPermissionsByMajor": {
    "15": [
      "server.view-state",
      "server.view-any-definition",
      "server.view-any-database"
    ],
    "16": [
      "server.view-performance-state",
      "server.view-any-database"
    ],
    "17": [
      "server.view-performance-state",
      "server.view-any-database"
    ]
  },
  "cadence": {
    "defaultIntervalSeconds": 30,
    "minimumIntervalSeconds": 10,
    "nonOverlappingPerTarget": true
  },
  "executionBounds": {
    "connectTimeoutSeconds": 5,
    "commandTimeoutSeconds": 5,
    "maximumRows": 2048,
    "maximumResponseBytes": 2097152
  },
  "estimatedCostClass": "moderate",
  "queryResources": {
    "supportedByMajor": {
      "15": "availability-groups.health.sqlserver15-windows.v2.sql",
      "16": "availability-groups.health.sqlserver16-windows.v2.sql",
      "17": "availability-groups.health.sqlserver17-windows.v2.sql"
    }
  },
  "fallback": {
    "mode": "unsupported"
  },
  "outputSchemaVersion": 2,
  "outputKind": "availability_groups_health"
}
