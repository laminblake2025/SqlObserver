{
  "$schema": "cpu.components.v1.schema.json",
  "schemaVersion": 6,
  "collectorId": "cpu.components",
  "collectorVersion": 1,
  "displayName": "SQL process and target host CPU",
  "operationalMode": "passive",
  "dependsOn": [
    "capability.connection"
  ],
  "supportedTargets": {
    "product": "Microsoft SQL Server",
    "minimumMajorVersion": 15,
    "maximumMajorVersion": 17,
    "platforms": [
      "Windows"
    ],
    "engineEditions": [
      2,
      3
    ]
  },
  "requiredCapabilities": [
    "connection.tds",
    "authentication.windows-integrated",
    "transport.tls-validated",
    "privilege.non-sysadmin",
    "platform.windows"
  ],
  "requiredPermissionsByMajor": {
    "15": [
      "server.view-state"
    ],
    "16": [
      "server.view-performance-state"
    ],
    "17": [
      "server.view-performance-state"
    ]
  },
  "cadence": {
    "defaultIntervalSeconds": 60,
    "minimumIntervalSeconds": 30,
    "nonOverlappingPerTarget": true
  },
  "executionBounds": {
    "connectTimeoutSeconds": 5,
    "commandTimeoutSeconds": 30,
    "maximumRows": 6,
    "maximumResponseBytes": 212992
  },
  "resilience": {
    "maximumAttempts": 1,
    "transientRetryDelayMilliseconds": 0,
    "circuitFailureThreshold": 3,
    "circuitOpenSeconds": 300
  },
  "estimatedCostClass": "moderate",
  "fallback": {
    "mode": "unsupported"
  },
  "queryResource": "cpu.target-witness.sqlserver15-17-windows.v2.sql",
  "outputSchemaVersion": 1,
  "outputKind": "cpu-components",
  "defaultEnabled": false
}
