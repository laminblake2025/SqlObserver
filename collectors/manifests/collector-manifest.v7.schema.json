{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sqlobserver.local/collector-manifest.v7.schema.json",
  "title": "SqlObserver staged backup v2 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "collectorId",
    "collectorVersion",
    "displayName",
    "operationalMode",
    "dependsOn",
    "supportedTargets",
    "requiredCapabilities",
    "requiredPermissionsByMajor",
    "conditionalPermissions",
    "cadence",
    "executionBounds",
    "sourceBounds",
    "estimatedCostClass",
    "queryResources",
    "fallback",
    "outputSchemaVersion",
    "outputKind"
  ],
  "properties": {
    "$schema": {
      "const": "collector-manifest.v7.schema.json"
    },
    "schemaVersion": {
      "const": 7
    },
    "collectorId": {
      "const": "backups.status"
    },
    "collectorVersion": {
      "const": 2
    },
    "displayName": {
      "const": "SQL Server backup freshness evidence"
    },
    "operationalMode": {
      "const": "passive"
    },
    "dependsOn": {
      "const": [
        "capability.connection",
        "engine.core"
      ]
    },
    "supportedTargets": {
      "const": {
        "product": "Microsoft SQL Server",
        "minimumMajorVersion": 15,
        "maximumMajorVersion": 17,
        "platforms": [
          "Windows"
        ],
        "engineEditions": [
          2,
          3,
          4
        ]
      }
    },
    "requiredCapabilities": {
      "const": [
        "connection.tds",
        "authentication.windows-integrated",
        "transport.tls-validated",
        "privilege.non-sysadmin",
        "platform.windows"
      ]
    },
    "requiredPermissionsByMajor": {
      "const": {
        "15": [
          "server.view-state",
          "server.view-any-database",
          "msdb.backupset.select"
        ],
        "16": [
          "server.view-performance-state",
          "server.view-any-database",
          "msdb.backupset.select"
        ],
        "17": [
          "server.view-performance-state",
          "server.view-any-database",
          "msdb.backupset.select"
        ]
      }
    },
    "conditionalPermissions": {
      "const": {
        "capabilityId": "feature.availability-groups",
        "requiredPermissionsByMajor": {
          "15": [
            "server.view-any-definition"
          ],
          "16": [],
          "17": []
        }
      }
    },
    "cadence": {
      "const": {
        "defaultIntervalSeconds": 300,
        "minimumIntervalSeconds": 60,
        "nonOverlappingPerTarget": true
      }
    },
    "executionBounds": {
      "const": {
        "connectTimeoutSeconds": 5,
        "commandTimeoutSeconds": 5,
        "maximumRows": 3072,
        "maximumResponseBytes": 4194304
      }
    },
    "sourceBounds": {
      "const": {
        "maximumDatabases": 512,
        "maximumSamplesPerDatabase": 5,
        "historyLookbackDays": 35,
        "rowLookahead": 1,
        "databaseLookahead": 1
      }
    },
    "estimatedCostClass": {
      "const": "moderate"
    },
    "queryResources": {
      "const": {
        "supportedByMajor": {
          "15": "backups.status.sqlserver15-windows.v2.sql",
          "16": "backups.status.sqlserver16-windows.v2.sql",
          "17": "backups.status.sqlserver17-windows.v2.sql"
        }
      }
    },
    "fallback": {
      "const": {
        "mode": "unsupported"
      }
    },
    "outputSchemaVersion": {
      "const": 2
    },
    "outputKind": {
      "const": "backups_status"
    }
  }
}
