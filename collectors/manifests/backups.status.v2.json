{
  "$schema": "collector-manifest.v7.schema.json",
  "schemaVersion": 7,
  "collectorId": "backups.status",
  "collectorVersion": 2,
  "displayName": "SQL Server backup freshness evidence",
  "operationalMode": "passive",
  "dependsOn": [
    "capability.connection",
    "engine.core"
  ],
  "supportedTargets": {
    "product": "Microsoft SQL Server",
    "minimumMajorVersion": 15,
    "maximumMajorVersion": 17,
    "platforms": [
      "Windows"
    ],
    "engineEditions": [
      2,
      3,
      4
    ]
  },
  "requiredCapabilities": [
    "connection.tds",
    "authentication.windows-integrated",
    "transport.tls-validated",
    "privilege.non-sysadmin",
    "platform.windows"
  ],
  "requiredPermissionsByMajor": {
    "15": [
      "server.view-state",
      "server.view-any-database",
      "msdb.backupset.select"
    ],
    "16": [
      "server.view-performance-state",
      "server.view-any-database",
      "msdb.backupset.select"
    ],
    "17": [
      "server.view-performance-state",
      "server.view-any-database",
      "msdb.backupset.select"
    ]
  },
  "conditionalPermissions": {
    "capabilityId": "feature.availability-groups",
    "requiredPermissionsByMajor": {
      "15": [
        "server.view-any-definition"
      ],
      "16": [],
      "17": []
    }
  },
  "cadence": {
    "defaultIntervalSeconds": 300,
    "minimumIntervalSeconds": 60,
    "nonOverlappingPerTarget": true
  },
  "executionBounds": {
    "connectTimeoutSeconds": 5,
    "commandTimeoutSeconds": 5,
    "maximumRows": 3072,
    "maximumResponseBytes": 4194304
  },
  "sourceBounds": {
    "maximumDatabases": 512,
    "maximumSamplesPerDatabase": 5,
    "historyLookbackDays": 35,
    "rowLookahead": 1,
    "databaseLookahead": 1
  },
  "estimatedCostClass": "moderate",
  "queryResources": {
    "supportedByMajor": {
      "15": "backups.status.sqlserver15-windows.v2.sql",
      "16": "backups.status.sqlserver16-windows.v2.sql",
      "17": "backups.status.sqlserver17-windows.v2.sql"
    }
  },
  "fallback": {
    "mode": "unsupported"
  },
  "outputSchemaVersion": 2,
  "outputKind": "backups_status"
}
