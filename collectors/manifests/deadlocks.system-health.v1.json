{
  "$schema": "collector-manifest.v4.schema.json",
  "schemaVersion": 4,
  "collectorId": "deadlocks.system-health",
  "collectorVersion": 1,
  "displayName": "SQL Server system_health deadlock evidence",
  "operationalMode": "passive",
  "dependsOn": ["capability.connection", "engine.core", "activity.sessions", "activity.requests", "waits.server", "blocking.current"],
  "supportedTargets": { "product": "Microsoft SQL Server", "minimumMajorVersion": 15, "maximumMajorVersion": 17, "platforms": ["Windows"], "engineEditions": [2, 3, 4] },
  "requiredCapabilities": ["connection.tds", "authentication.windows-integrated", "transport.tls-validated", "privilege.non-sysadmin", "platform.windows"],
  "requiredPermissionsByMajor": { "15": ["server.view-state"], "16": ["server.view-performance-state"], "17": ["server.view-performance-state"] },
  "cadence": { "defaultIntervalSeconds": 30, "minimumIntervalSeconds": 10, "nonOverlappingPerTarget": true },
  "executionBounds": { "connectTimeoutSeconds": 5, "commandTimeoutSeconds": 5, "maximumRows": 257, "maximumResponseBytes": 1048576 },
  "resilience": { "maximumAttempts": 2, "transientRetryDelayMilliseconds": 100, "circuitFailureThreshold": 3, "circuitOpenSeconds": 300 },
  "estimatedCostClass": "moderate",
  "queryResources": { "supportedByMajor": { "15": "deadlocks.system-health.sqlserver15-windows.v1.sql", "16": "deadlocks.system-health.sqlserver16-windows.v1.sql", "17": "deadlocks.system-health.sqlserver17-windows.v1.sql" } },
  "fallback": { "mode": "unsupported" },
  "outputSchemaVersion": 1,
  "outputKind": "deadlocks"
}
