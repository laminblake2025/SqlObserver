{
  "$schema": "collector-manifest.schema.json",
  "schemaVersion": 1,
  "collectorId": "capability.connection",
  "collectorVersion": 1,
  "displayName": "SQL Server capability and connection",
  "operationalMode": "passive",
  "supportedTargets": {
    "product": "Microsoft SQL Server",
    "minimumMajorVersion": 15,
    "maximumMajorVersion": 17,
    "platforms": ["Windows"],
    "engineEditions": [2, 3, 4]
  },
  "requiredCapabilities": [
    "connection.tds",
    "authentication.windows-integrated",
    "transport.tls-validated",
    "privilege.non-sysadmin",
    "platform.windows"
  ],
  "requiredPermissionsByMajor": {
    "15": ["server.view-state"],
    "16": ["server.view-performance-state"],
    "17": ["server.view-performance-state"]
  },
  "cadence": {
    "defaultIntervalSeconds": 300,
    "minimumIntervalSeconds": 60,
    "nonOverlappingPerTarget": true
  },
  "executionBounds": {
    "connectTimeoutSeconds": 5,
    "commandTimeoutSeconds": 5,
    "maximumRows": 1,
    "maximumResponseBytes": 16384
  },
  "estimatedCostClass": "low",
  "queryResources": {
    "bootstrap": "capability.connection.bootstrap.v1.sql",
    "supportedByMajor": {
      "15": "capability.connection.sqlserver15-windows.v1.sql",
      "16": "capability.connection.sqlserver16-windows.v1.sql",
      "17": "capability.connection.sqlserver17-windows.v1.sql"
    },
    "permissionFallback": "capability.connection.fallback.v1.sql"
  },
  "fallback": {
    "mode": "unsupported"
  },
  "outputSchemaVersion": 1
}
