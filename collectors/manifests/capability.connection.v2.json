{
  "$schema": "capability.connection.v2.schema.json",
  "schemaVersion": 2,
  "collectorId": "capability.connection",
  "collectorVersion": 2,
  "displayName": "SQL Server capability and connection v2",
  "operationalMode": "passive",
  "supportedTargets": { "product": "Microsoft SQL Server", "minimumMajorVersion": 15, "maximumMajorVersion": 17, "platforms": ["Windows"], "engineEditions": [2,3,4] },
  "requiredCapabilities": ["connection.tds", "authentication.windows-integrated", "transport.tls-validated", "privilege.non-sysadmin", "platform.windows"],
  "requiredPermissionsByMajor": { "15": ["server.view-state", "msdb.backupset.select", "msdb.sysjobhistory.select"], "16": ["server.view-performance-state", "msdb.backupset.select", "msdb.sysjobhistory.select"], "17": ["server.view-performance-state", "msdb.backupset.select", "msdb.sysjobhistory.select"] },
  "features": ["feature.sql-agent-history"],
  "queryResources": { "supportedByMajor": { "15": "capability.connection.sqlserver15-windows.v2.sql", "16": "capability.connection.sqlserver16-windows.v2.sql", "17": "capability.connection.sqlserver17-windows.v2.sql" } },
  "fallback": { "mode": "unsupported" },
  "outputSchemaVersion": 2
}
