{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://sqlobserver.local/engine.configurations.v1.schema.json",
  "title":"SqlObserver passive server configuration collector manifest v1",
  "type":"object","additionalProperties":false,
  "required":["$schema","schemaVersion","collectorId","collectorVersion","displayName","operationalMode","dependsOn","supportedTargets","requiredCapabilities","requiredPermissionsByMajor","cadence","executionBounds","resilience","estimatedCostClass","fallback","queryResources","outputSchemaVersion","outputKind","defaultEnabled"],
  "properties":{
    "$schema":{"const":"engine.configurations.v1.schema.json"},
    "schemaVersion":{"const":6},
    "collectorId":{"const":"engine.configurations"},
    "collectorVersion":{"const":1},
    "displayName":{"const":"SQL Server configuration evidence"},
    "operationalMode":{"const":"passive"},
    "dependsOn":{"const":["capability.connection","engine.core"]},
    "supportedTargets":{"const":{"product":"Microsoft SQL Server","minimumMajorVersion":15,"maximumMajorVersion":17,"platforms":["Windows"],"engineEditions":[2,3,4]}},
    "requiredCapabilities":{"const":["connection.tds","authentication.windows-integrated","transport.tls-validated","privilege.non-sysadmin","platform.windows"]},
    "requiredPermissionsByMajor":{"const":{"15":[],"16":["server.view-performance-state"],"17":["server.view-performance-state"]}},
    "cadence":{"const":{"defaultIntervalSeconds":300,"minimumIntervalSeconds":60,"nonOverlappingPerTarget":true}},
    "executionBounds":{"const":{"connectTimeoutSeconds":5,"commandTimeoutSeconds":5,"maximumRows":513,"maximumResponseBytes":65536}},
    "resilience":{"const":{"maximumAttempts":2,"transientRetryDelayMilliseconds":100,"circuitFailureThreshold":3,"circuitOpenSeconds":300}},
    "estimatedCostClass":{"const":"low"},
    "fallback":{"const":{"mode":"unsupported"}},
    "queryResources":{"const":{"15":"engine.configurations.sqlserver15-windows.v1.sql","16":"engine.configurations.sqlserver16-windows.v1.sql","17":"engine.configurations.sqlserver17-windows.v1.sql"}},
    "outputSchemaVersion":{"const":1},
    "outputKind":{"const":"server-configurations"},
    "defaultEnabled":{"const":false}
  }
}
